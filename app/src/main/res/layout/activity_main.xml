<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<!-- ===== CONTENIDO PRINCIPAL ===== -->
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <!-- ===== HEADER BLANCO ===== -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical"
        android:background="@android:color/white"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Hamburger -->
        <ImageButton
            android:id="@+id/btnHamburger"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_menu_hamburger"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menú"
            android:tint="#1A1A1A"/>

        <!-- Logo ESCOM -->
        <ImageView
            android:id="@+id/logo_escom"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/escom_logo"
            android:layout_marginStart="10dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>

        <!-- Título -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ESCOMobile"
            android:textColor="#1A1A1A"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>

    <!-- ===== SCROLL PRINCIPAL ===== -->
    <ScrollView
        android:id="@+id/scrollMain"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ===== BANNER FOTO ESCOM ===== -->
            <androidx.cardview.widget.CardView
                xmlns:card="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                card:cardCornerRadius="16dp"
                card:cardElevation="4dp">

                <ImageView
                    android:id="@+id/imgBanner"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:src="@drawable/escom_building"
                    android:scaleType="centerCrop"/>

            </androidx.cardview.widget.CardView>

            <!-- ===== SECCIÓN DOS COLUMNAS: Calendario + Redes ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="4dp">

                <!-- COLUMNA IZQUIERDA: Calendario PDF (WebView + overlay) -->
                <androidx.cardview.widget.CardView
                    xmlns:card="http://schemas.android.com/apk/res-auto"
                    android:id="@+id/cardCalendario"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:layout_marginEnd="8dp"
                    card:cardCornerRadius="12dp"
                    card:cardElevation="3dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:background="@android:color/white">

                        <!-- FrameLayout: preview PDF + spinner de carga + overlay -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:background="#EEF3FA">

                            <!-- ImageView: muestra la página 1 del PDF renderizada -->
                            <ImageView
                                android:id="@+id/imgCalendarioPreview"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:background="#EEF3FA"
                                android:visibility="gone"/>

                            <!-- Placeholder mientras carga -->
                            <LinearLayout
                                android:id="@+id/layoutCalendarioPlaceholder"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="#EEF3FA">

                                <ProgressBar
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:indeterminateTint="#003972"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Cargando calendario..."
                                    android:textColor="#003972"
                                    android:textSize="11sp"
                                    android:layout_marginTop="8dp"/>
                            </LinearLayout>

                            <!-- Overlay inferior: siempre visible sobre la imagen -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:paddingTop="12dp"
                                android:paddingBottom="10dp"
                                android:background="#CC003972">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@android:drawable/ic_menu_month"
                                    app:tint="#FFFFFF"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Calendario Escolar IPN"
                                    android:textColor="#FFFFFF"
                                    android:textStyle="bold"
                                    android:textSize="11sp"
                                    android:gravity="center"
                                    android:layout_marginTop="4dp"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Toca para ver"
                                    android:textColor="#AADDFF"
                                    android:textSize="10sp"
                                    android:layout_marginTop="2dp"/>
                            </LinearLayout>
                        </FrameLayout>

                        <!-- Botón Ver completo -->
                        <LinearLayout
                            android:id="@+id/fab"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:background="#003972"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@android:drawable/ic_menu_view"
                                app:tint="#FFFFFF"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ver completo"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:layout_marginStart="4dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- COLUMNA DERECHA: Redes sociales -->
                <androidx.cardview.widget.CardView
                    xmlns:card="http://schemas.android.com/apk/res-auto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="0.8"
                    android:layout_marginStart="8dp"
                    card:cardCornerRadius="12dp"
                    card:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@android:color/white"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Redes Sociales"
                            android:textColor="#1A1A1A"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:layout_marginBottom="6dp"
                            android:layout_gravity="center_horizontal"/>

                        <!-- Facebook -->
                        <LinearLayout
                            android:id="@+id/btnFacebook"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">

                            <ImageView
                                android:id="@+id/imgFacebook"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_facebook"
                                android:scaleType="centerCrop"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Facebook"
                                android:textColor="#333333"
                                android:textSize="11sp"
                                android:layout_marginStart="8dp"/>
                        </LinearLayout>

                        <!-- WhatsApp -->
                        <LinearLayout
                            android:id="@+id/btnWhats"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">

                            <ImageView
                                android:id="@+id/imgWhatsapp"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_whatsapp"
                                android:scaleType="centerCrop"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="WhatsApp"
                                android:textColor="#333333"
                                android:textSize="11sp"
                                android:layout_marginStart="8dp"/>
                        </LinearLayout>

                        <!-- Página web -->
                        <LinearLayout
                            android:id="@+id/btnWeb"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">

                            <ImageView
                                android:id="@+id/img_web"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_web"
                                android:scaleType="centerCrop"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Página Web"
                                android:textColor="#333333"
                                android:textSize="11sp"
                                android:layout_marginStart="8dp"/>
                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- ===== SECCIÓN FACEBOOK EMBED ===== -->
            <androidx.cardview.widget.CardView
                xmlns:card="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="610dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                card:cardCornerRadius="12dp"
                card:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:background="@android:color/white"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Facebook ESCOM Oficial"
                        android:textColor="#1A1A1A"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp"/>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <WebView
                            android:id="@+id/webFacebook"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>

                        <LinearLayout
                            android:id="@+id/placeholderFacebook"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@android:color/white">

                            <ProgressBar
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:indeterminateTint="#1877F2"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cargando Facebook..."
                                android:textColor="#1877F2"
                                android:textSize="12sp"
                                android:layout_marginTop="10dp"/>
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== SECCIÓN INSTAGRAM EMBED ===== -->
            <androidx.cardview.widget.CardView
                xmlns:card="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="610dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                card:cardCornerRadius="12dp"
                card:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:background="@android:color/white"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Instagram ESCOM Oficial"
                        android:textColor="#1A1A1A"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp"/>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <WebView
                            android:id="@+id/webInstagram"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>

                        <LinearLayout
                            android:id="@+id/placeholderInstagram"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@android:color/white">

                            <ProgressBar
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:indeterminateTint="#C13584"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cargando Instagram..."
                                android:textColor="#C13584"
                                android:textSize="12sp"
                                android:layout_marginTop="10dp"/>
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- ===== FAB CHATBOT ===== -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_chat"
        android:contentDescription="Chatbot"
        app:backgroundTint="#2196F3"
        app:fabSize="normal"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"/>

    <!-- ===== BOTTOM NAV (píldora redondeada) ===== -->
    <FrameLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:background="@drawable/bottom_nav_pill"
            android:gravity="center">

            <Button
                android:id="@+id/btnInicio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Inicio"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@android:color/transparent"/>

            <Button
                android:id="@+id/btnConsultar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Consultar"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:background="@android:color/transparent"/>

            <Button
                android:id="@+id/btnMapa"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Mapa"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:background="@android:color/transparent"/>
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<!-- ===== SIDEBAR / DRAWER ===== -->
<LinearLayout
    android:id="@+id/navDrawer"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:elevation="8dp">

    <!-- Cabecera del drawer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:orientation="vertical"
        android:gravity="bottom"
        android:padding="20dp"
        android:background="#003972">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/escom_logo"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESCOMobile"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="6dp"/>
    </LinearLayout>

    <!-- Opción: Recordatorios -->
    <LinearLayout
        android:id="@+id/menuRecordatorios"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_star_circle"
            app:tint="#003972"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Recordatorios"
            android:textColor="#1A1A1A"
            android:textSize="15sp"
            android:layout_marginStart="16dp"/>

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@android:drawable/ic_media_next"
            app:tint="#AAAAAA"/>
    </LinearLayout>

    <!-- Divisor -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="#EEEEEE"/>

    <!-- Opción: Acerca de -->
    <LinearLayout
        android:id="@+id/menuAcercaDe"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_info_details"
            app:tint="#003972"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Acerca de"
            android:textColor="#1A1A1A"
            android:textSize="15sp"
            android:layout_marginStart="16dp"/>

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@android:drawable/ic_media_next"
            app:tint="#AAAAAA"/>
    </LinearLayout>

</LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>